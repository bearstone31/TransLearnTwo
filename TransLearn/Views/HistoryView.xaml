<!--
    HistoryView.xaml
    역할 : "번역 기록" 화면. 내부 서브탭으로 번역 기록 목록 ↔ 캡처 관리(갤러리) 전환.

    [수정] CaptureGalleryView 는 자체 DataContext(CaptureGalleryViewModel)를 갖기 때문에
           Visibility 바인딩이 HistoryViewModel.IsGalleryTab 을 찾지 못했다.
           → RelativeSource 로 Page 의 DataContext 를 명시해 해결.
-->
<Page x:Class="TransLearn.Views.HistoryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:TransLearn.ViewModels"
      xmlns:conv="clr-namespace:TransLearn.Converters"
      xmlns:models="clr-namespace:TransLearn.Models"
      xmlns:views="clr-namespace:TransLearn.Views"
      Background="{StaticResource BgMain}"
      Title="번역 기록">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True"/>
        <conv:NotEmptyVisibilityConverter x:Key="NotEmptyVis"/>
        <conv:ImagePathToBitmapConverter x:Key="ImgConv"/>
        <conv:ImageAvailableVisibilityConverter x:Key="ImgAvailVis"/>
    </Page.Resources>

    <Page.DataContext>
        <vm:HistoryViewModel/>
    </Page.DataContext>

    <!-- Auto-load on navigate -->
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard/>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- [추가] 내부 탭 전환: 번역 기록 목록 ↔ 캡처 관리(갤러리) -->
        <!-- 현재 탭은 완전 불투명, 비활성 탭은 흐리게 — 어느 탭이 선택됐는지 눈에 보이게 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="📋 번역 기록"
                    Command="{Binding ShowListTabCommand}"
                    Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGalleryTab}" Value="True">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="🖼 캡처 관리"
                    Command="{Binding ShowGalleryTabCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Opacity" Value="0.45"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGalleryTab}" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Header -->
        <Grid Grid.Row="1" Margin="0,0,0,12"
              Visibility="{Binding IsGalleryTab, Converter={StaticResource BoolVisInv}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="번역 기록" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="{Binding TotalCount, StringFormat='총 {0}개'}"
                           Foreground="{StaticResource TextSecond}" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="1" Content="🔄 새로고침"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <!-- Search & Filter bar -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                Visibility="{Binding IsGalleryTab, Converter={StaticResource BoolVisInv}}">
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="🔍  검색어 입력...">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush AlignmentX="Left" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <Label Content="🔍  검색어 입력..."
                                                           Foreground="{StaticResource TextSecond}"
                                                           FontSize="12"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding FilterType}"
                          Foreground="Black">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="Black"
                                       FontWeight="SemiBold"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- Row 3 : 아래 세 요소가 같은 칸을 공유하므로                     -->
        <!--         Visibility 가 정확히 배타적이어야 한다                  -->
        <!-- ══════════════════════════════════════════════════════════════ -->

        <!-- Loading indicator -->
        <Border Grid.Row="3"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="⏳ 로딩 중..." Foreground="{StaticResource TextSecond}" FontSize="16"/>
        </Border>

        <!-- [수정] 캡처 관리 갤러리 탭
             CaptureGalleryView 는 <UserControl.DataContext> 로 자기 ViewModel 을 갖는다.
             따라서 {Binding IsGalleryTab} 은 CaptureGalleryViewModel 에서 경로를 찾다가 실패하고,
             Visibility 가 기본값 Visible 로 남아 목록 위에 항상 겹쳐 그려졌다.
             Page 의 DataContext(HistoryViewModel)를 명시해 해결한다. -->
        <views:CaptureGalleryView Grid.Row="3"
                Visibility="{Binding DataContext.IsGalleryTab,
                             RelativeSource={RelativeSource AncestorType=Page},
                             Converter={StaticResource BoolVis}}"/>

        <!-- Grouped list with virtualization -->
        <ListView Grid.Row="3"
                  Visibility="{Binding IsGalleryTab, Converter={StaticResource BoolVisInv}}"
                  ItemsSource="{Binding GroupedView.View}"
                  Background="Transparent"
                  BorderThickness="0"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Item"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgCard}"
                                    CornerRadius="6" Margin="0,8,0,2"
                                    Padding="12,6">
                                <TextBlock FontWeight="Bold" FontSize="12"
                                           Foreground="{StaticResource TextAccent}">
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                    <Run Text=" ("/><Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text="개)"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background"         Value="Transparent"/>
                    <Setter Property="BorderThickness"    Value="0"/>
                    <Setter Property="Padding"            Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:TranslationRecord}">
                    <Border Margin="0,2" Padding="14,10"
                            Background="{StaticResource BgCard}"
                            CornerRadius="6"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding OriginalText}"
                                       Foreground="{StaticResource TextAccent}"
                                       FontSize="13" TextWrapping="Wrap" Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Translated}"
                                       Foreground="{StaticResource TextGreen}"
                                       FontSize="13" TextWrapping="Wrap" Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TimeLabel}"
                                           Foreground="{StaticResource TextSecond}" FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding AppName}"
                                           Foreground="{StaticResource TextSecond}" FontSize="10"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                            </StackPanel>

                            <!-- [추가] 번역 시점 캡처 썸네일 — 클릭하면 기본 이미지 뷰어로 원본을 연다 -->
                            <Border Grid.Column="3" Width="52" Height="36"
                                    CornerRadius="4" Margin="0,0,8,0"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                    Visibility="{Binding ImagePath, Converter={StaticResource ImgAvailVis}}"
                                    Cursor="Hand"
                                    ToolTip="캡처 이미지 보기 (클릭)"
                                    MouseLeftButtonUp="Thumbnail_Click">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding ImagePath, Converter={StaticResource ImgConv}}"
                                                Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>

                            <Button Grid.Column="4"
                                    Content="🗑"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#EF5350"
                                    FontSize="16"
                                    Cursor="Hand"
                                    ToolTip="이 기록 삭제"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
