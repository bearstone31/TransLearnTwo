<!--
    CaptureGalleryView.xaml [추가]
    역할 : "캡처 관리" 탭 — 번역 시점에 저장된 스크린샷을 갤러리 카드로 보여준다.
           캡처 유형 → 날짜 → 응용프로그램 순 계단식 필터 제공.
    사용처 : HistoryView.xaml 내부 서브탭에 삽입됨.
-->
<UserControl x:Class="TransLearn.Views.CaptureGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TransLearn.ViewModels"
             xmlns:conv="clr-namespace:TransLearn.Converters"
             xmlns:models="clr-namespace:TransLearn.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:ImagePathToBitmapConverter x:Key="ImgConv"/>
        <conv:ImageAvailableVisibilityConverter x:Key="ImgMissingVis" Invert="True"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:CaptureGalleryViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding TotalCount, StringFormat='캡처 {0}개'}"
                       Foreground="{StaticResource TextSecond}" FontSize="12"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="🔄 새로고침"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <!-- 계단식 필터: 유형 → 날짜 → 응용프로그램 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="1. 캡처 유형" FontSize="11" Foreground="{StaticResource TextSecond}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" Foreground="Black">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="Black" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="2. 날짜" FontSize="11" Foreground="{StaticResource TextSecond}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding DateOptions}" SelectedItem="{Binding SelectedDate}" Foreground="Black">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="Black" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="3. 응용프로그램" FontSize="11" Foreground="{StaticResource TextSecond}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AppOptions}" SelectedItem="{Binding SelectedApp}" Foreground="Black">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="Black" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 로딩 -->
        <Border Grid.Row="2"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="⏳ 로딩 중..." Foreground="{StaticResource TextSecond}" FontSize="16"/>
        </Border>

        <!-- 빈 상태 -->
        <TextBlock Grid.Row="2"
                   Text="캡처된 이미지가 없습니다. 캡처 기능이 켜져 있는지 설정에서 확인해 보세요."
                   Foreground="{StaticResource TextSecond}" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasNoItems, Converter={StaticResource BoolVis}}"/>

        <!-- 갤러리 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding GalleryItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TranslationRecord}">
                        <Border Width="190" Margin="0,0,12,12" Padding="10"
                                Background="{StaticResource BgCard}" CornerRadius="8"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                Cursor="Hand" ToolTip="클릭하면 원본 이미지가 열립니다"
                                MouseLeftButtonUp="GalleryCard_Click">
                            <StackPanel>
                                <!-- [추가] 썸네일 + 파일이 삭제/이동됐을 때의 대체 표시 -->
                                <Grid Height="110" Background="{StaticResource BgInput}">
                                    <Border CornerRadius="6" ClipToBounds="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ImagePath, Converter={StaticResource ImgConv}}"
                                                        Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="🚫 파일 없음" FontSize="10"
                                               Foreground="{StaticResource TextSecond}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding ImagePath, Converter={StaticResource ImgMissingVis}}"/>
                                </Grid>
                                <TextBlock Text="{Binding CaptureTypeLabel}" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccent}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding AppName}" FontSize="11"
                                           Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding OriginalText}" FontSize="10"
                                           Foreground="{StaticResource TextSecond}"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecond}" Margin="0,4,0,0">
                                    <Run Text="{Binding DateLabel, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding TimeLabel, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
